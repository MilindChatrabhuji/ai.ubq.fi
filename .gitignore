# dev tooling (see tools/lint/README.md)
# No trailing slash: scripts/_bootstrap.sh symlinks tools/lint/node_modules to
# the main checkout's install in a new worktree, and a trailing slash only
# matches directories, so the symlink stayed stageable and `git add -A` picked it
# up as a tracked file containing an absolute path.
node_modules
.npm-cache/
.npm/
.bun-cache/
.tmp/
.cloudflare/

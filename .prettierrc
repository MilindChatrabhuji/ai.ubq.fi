{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "printWidth": 160,
  "htmlWhitespaceSensitivity": "strict",
  "plugins": [],
  "useTabs": false,
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.md", "*.js", "*.cjs", "*.css", "*.html", "*.yml", "*.yaml"],
      "options": {
        "printWidth": 120
      }
    },
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always"
      }
    }
  ]
}
